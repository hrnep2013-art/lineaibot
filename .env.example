# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูก commit เข้า git)

# LINE Developers Console → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Google AI Studio API key (สำหรับ @google/genai)
GEMINI_API_KEY=

# Google Sheet: File → Share → Publish to web → เลือกชีต FAQ → format CSV → คัดลอกลิงก์
SHEET_CSV_URL=

# รหัสผ่านป้องกันหน้า /admin/upload (ตั้งเองได้ อะไรก็ได้ที่คาดเดายาก)
ADMIN_UPLOAD_SECRET=

# ชื่อ File Search store — ได้มาจากการกด "สร้าง Store" ที่ /admin/upload ครั้งแรก
# (ไม่บังคับ ถ้าเว้นว่างไว้บอทจะทำงานแบบเดิมโดยไม่มี File Search)
GEMINI_FILE_SEARCH_STORE=
